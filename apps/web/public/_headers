# Cabeçalhos de segurança do front (Cloudflare Pages). Valem a partir do deploy; hoje o front só roda em dev/CI.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://*.supabase.co; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /
/api/*
  Cache-Control: no-store
